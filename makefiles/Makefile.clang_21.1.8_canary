CC=~/pool/llvm-project/install/canarCanaryRelWithDebInfo/bin/clang
CXX=~/pool/llvm-project/install/canaryClang21.1.8Release/bin/clang++
# no FC for clang
FC=
flags = -O3 -g3 -fno-discard-value-names -fstrict-aliasing -march=native
vecflags = -fvectorize
#-fslp-vectorize-aggressive
novecflags = -fno-vectorize
omp_flags=-fopenmp=libomp

ifdef VEC_REPORT
vecflags+=-fsave-optimization-record
#vecflags+=-mllvm -debug-only=loop-vectorize
#vecflags+=-Rpass-analysis=loop-vectorize
endif

ieee_math_flags+=
fast_math_flags+=-ffast-math

ifdef PRECISE_MATH
$(warning No 'precise' math flags for clang!)
endif

